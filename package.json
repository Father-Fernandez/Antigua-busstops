{
  "name": "antigua-busstops",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb",
    "spacetime:publish:local": "spacetime publish bus-system --module-path spacetimedb --server local --yes",
    "spacetime:publish": "spacetime publish bus-system-qcj1z --module-path spacetimedb --server maincloud --yes"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "spacetimedb": "2.12.*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.2",
    "vite": "^7.1.5",
    "vitest": "^5.0.5"
  }
}
